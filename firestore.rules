rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUserDocument(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow create: if ownsUserDocument(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email;
      allow read, update: if ownsUserDocument(userId);
      allow delete: if false;
    }

    match /orders/{orderId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.customerEmail == request.auth.token.email
        && request.resource.data.currency == 'INR'
        && request.resource.data.total > 0
        && request.resource.data.status == 'payment_verification_pending'
        && request.resource.data.payment.method == 'UPI'
        && request.resource.data.payment.status == 'pending_verification';
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
