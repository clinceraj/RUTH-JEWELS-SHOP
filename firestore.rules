rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner() {
      return signedIn() && exists(/databases/$(database)/documents/Owners/$(request.auth.uid));
    }
    function ownsUserDocument(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /Owners/{ownerId} {
      allow read: if signedIn() && request.auth.uid == ownerId;
      allow write: if false;
    }

    match /products/{productId} {
      allow read: if resource.data.status == 'published' || isOwner();
      allow create, update, delete: if isOwner();
    }

    match /categories/{categoryId} {
      allow read: if resource.data.status == 'active' || isOwner();
      allow create, update, delete: if isOwner();
    }

    match /campaigns/{campaignId} {
      allow read: if resource.data.status == 'active' || isOwner();
      allow create, update, delete: if isOwner();
    }

    match /users/{userId} {
      allow create: if ownsUserDocument(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email;
      allow read, update: if ownsUserDocument(userId);
      allow delete: if false;
    }

    match /orders/{orderId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.customerEmail == request.auth.token.email
        && request.resource.data.currency == 'INR'
        && request.resource.data.total > 0
        && request.resource.data.status == 'payment_verification_pending'
        && request.resource.data.payment.method == 'UPI'
        && request.resource.data.payment.status == 'pending_verification';
      allow read: if isOwner() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isOwner();
    }
  }
}

